
# Gas Detection (Multimodal) — Environment Configuration
# Copy this file and set values for your deployment
# Usage: ./setup.sh --use-case gas-detection

# ── Deployment ────────────────────────────────────────────────────────────────
USE_CASE_ID=gas-detection
APP_HOST_PORT=8080
# Host/IP shown in the "Application started" URL and used for any host-networked
# access. Defaults to localhost if left unset — override with your machine's LAN
# IP if you need to reach the dashboard from another device.
HOST_IP=localhost

# API key used by agent/storage mutating endpoints (X-API-Key header)
# Change this value before exposing the stack beyond localhost/trusted networks.
APM_API_KEY=change-me-apm-key

# ── LLM / VLM ────────────────────────────────────────────────────────────────
# This use case fuses a DL Streamer whole-frame image classification with a
# sensor reading and uses the LLM for narrative reasoning by default.
# Set LLM_MODE=fallback to run without an LLM (rule-based operation).
LLM_MODE=llm
LLM_MODEL_NAME=microsoft/Phi-4-mini-instruct
LLM_DEVICE=CPU
LLM_WEIGHT_FORMAT=int4
LLM_PORT=8010

# ── DL Streamer ───────────────────────────────────────────────────────────────
# DL Streamer devices shown in the UI are detected from host hardware:
# CPU is always shown, GPU is shown when /dev/dri/render* exists, and NPU is
# shown when /dev/accel exists. Accelerator device mounts are added only when
# the corresponding host device exists.
DL_DEVICE=CPU
PIPELINE_SERVER_PORT=8554

# Pipeline names for this use case's gvaclassify (whole-frame image
# classification) pipeline definitions (configs/pipeline-server-config.json),
# keyed by device — read by detection-service's dlstreamer_client.py.
DLSTREAMER_PIPELINE_NAME_CPU=gas_detection_multimodal
DLSTREAMER_PIPELINE_NAME_GPU=gas_detection_multimodal_gpu
DLSTREAMER_PIPELINE_NAME_NPU=gas_detection_multimodal_npu

# Dedicated MQTT topic the gas classification pipeline publishes per-frame
# whole-image classifications to. Deliberately NOT the shared MQTT_TOPIC
# (apm/detections) — raw, unfused per-frame classifications are collected
# in-memory for one run only (see dlstreamer_mqtt_collector.py) and never
# persisted to storage-service on their own; only the final fused result
# (image + paired sensor reading) is.
GAS_CLASSIFICATION_MQTT_TOPIC=apm/gas-image-classifications

# ── Model Download ────────────────────────────────────────────────────────────
# HuggingFace token — required for gated models when LLM_MODE=llm.
# HUGGINGFACEHUB_API_TOKEN=hf_...
MODEL_DOWNLOAD_PORT=8200

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt-broker
MQTT_PORT=18830
MQTT_TOPIC=dlstreamer/detections

# ── Pipeline execution model ──────────────────────────────────────────────────
# Use the "Run Multimodal Detection" button on the dashboard (UI Service),
# which POSTs to /api/detection/run-multimodal with the config below — or
# trigger it directly:
#   curl -X POST http://${HOST_IP}:${APP_HOST_PORT}/api/detection/run-multimodal \
#        -H "Content-Type: application/json" \
#        -d '{"device":"CPU","config_path":"/app/configs/gas_detection.docker.json"}'
# Each call runs the gvaclassify DL Streamer pipeline over datastream.mp4
# once end-to-end (whole-frame image classification per frame), re-joins
# each frame to its paired sensor CSV row via frame_manifest.json, fuses both
# modalities, persists the fused results to storage-service, and publishes
# the same "batch-complete" MQTT event the agent-service reacts to for the
# video pipeline path.
MULTIMODAL_CONFIG_PATH=/app/configs/gas_detection.docker.json

# ── Telemetry ─────────────────────────────────────────────────────────────────
METRICS_PORT=9091
PROMETHEUS_PORT=9090

# ── Registry (leave empty to use local builds) ───────────────────────────────
REGISTRY=
TAG=latest

# Set automatically by scripts/download_llm_model.sh
LLM_MODEL_PATH=./apps/gas-detection-multimodal/models/llm_model_gas-detection/openvino_models/cpu/int4/microsoft/Phi-4-mini-instruct
