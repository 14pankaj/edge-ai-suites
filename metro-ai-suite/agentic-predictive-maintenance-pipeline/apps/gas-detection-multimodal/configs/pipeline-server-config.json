{
    "config": {
        "pipelines": [
            {
                "name": "gas_detection_multimodal",
                "source": "gstreamer",
                "queue_maxsize": 50,
                "payload": {
                    "source": {
                        "uri": "file:///home/pipeline-server/resources/videos/datastream.mp4",
                        "type": "uri"
                    },
                    "destination": {
                        "metadata": {
                            "type": "mqtt",
                            "topic": "apm/gas-image-classifications"
                        }
                    }
                },
                "pipeline": "{auto_source} name=source ! decodebin3 ! gvaclassify model=/home/pipeline-server/models/image/best.xml device=CPU inference-region=full-frame name=classification ! gvametaconvert add-empty-results=true name=metaconvert ! queue ! gvafpscounter ! appsink name=destination",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "classification-properties": {
                            "element": {
                                "name": "classification",
                                "format": "element-properties"
                            }
                        }
                    }
                },
                "auto_start": false
            },
            {
                "name": "gas_detection_multimodal_gpu",
                "source": "gstreamer",
